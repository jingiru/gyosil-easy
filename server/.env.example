# 중앙 서버
HOST=0.0.0.0
PORT=3000
DEFAULT_ROOM=classroom-1

# 상대 경로는 server 폴더 기준입니다.
DATABASE_PATH=./data/gyosil-easy.db

# 별도 정적 호스팅을 사용할 때만 주소를 쉼표로 구분해 입력하세요.
# 예: http://192.168.0.50:5173,https://example.github.io
ALLOWED_ORIGINS=

# 비워두면 PIN 확인을 사용하지 않습니다. 운영 시 4자리 이상 설정을 권장합니다.
TEACHER_PIN=

# 응답/기록 보관 개수
HISTORY_LIMIT=100
